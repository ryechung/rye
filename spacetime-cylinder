    const MIN_YEAR = 1895;
    const MAX_YEAR = 2026;
    const CYLINDER_HEIGHT = 46;
    const BASE_Y = -CYLINDER_HEIGHT / 2;

    function yearToY(year) {
      return ((year - MIN_YEAR) / (MAX_YEAR - MIN_YEAR) - 0.5) * CYLINDER_HEIGHT;
    }

    function getCityXZForEntity(cityName, entityKey) {
      const base = CITIES[cityName] || { x: 0, z: 0 };
      const item = TRAJECTORIES[entityKey];
      const sharedCities = ["闽侯福州", "上海", "基隆", "台北", "高雄"];
      if (sharedCities.includes(cityName) && item && item.offset) {
        return { x: base.x + item.offset.x, z: base.z + item.offset.z };
      }
      return { x: base.x, z: base.z };
    }

    function getEntityPosAtYear(entityKey, year) {
      const item = TRAJECTORIES[entityKey];
      if (!item) return null;
      const kfs = item.keyframes;
      if (year < kfs[0].year) return null;
      if (year > kfs[kfs.length - 1].year) return null;

      for (let i = 0; i < kfs.length - 1; i++) {
        if (year >= kfs[i].year && year <= kfs[i + 1].year) {
          if (kfs[i].city === kfs[i+1].city) {
            const p = getCityXZForEntity(kfs[i].city, entityKey);
            return { x: p.x, y: yearToY(year), z: p.z, baseX: p.x, baseZ: p.z, currentCity: kfs[i].city };
          }
          const t = (year - kfs[i].year) / (kfs[i + 1].year - kfs[i].year);
          const p1 = getCityXZForEntity(kfs[i].city, entityKey);
          const p2 = getCityXZForEntity(kfs[i + 1].city, entityKey);
          return {
            x: p1.x + (p2.x - p1.x) * t,
            y: yearToY(year),
            z: p1.z + (p2.z - p1.z) * t,
            baseX: p1.x + (p2.x - p1.x) * t,
            baseZ: p1.z + (p2.z - p1.z) * t,
            currentCity: t < 0.5 ? kfs[i].city : kfs[i + 1].city
          };
        }
      }
      return null;
    }

    /* 核心：标签直显 “姓名 · 当前城市” */
    function createNameSprite(displayText, colorHex) {
      const canvas = document.createElement("canvas");
      canvas.width = 440;
      canvas.height = 96;
      const ctx = canvas.getContext("2d");

      ctx.fillStyle = "rgba(12, 12, 18, 0.92)";
      ctx.strokeStyle = colorHex;
      ctx.lineWidth = 3.5;
      
      ctx.beginPath();
      const r = 18;
      ctx.moveTo(8 + r, 8);
      ctx.lineTo(432 - r, 8);
      ctx.quadraticCurveTo(432, 8, 432, 8 + r);
      ctx.lineTo(432, 88 - r);
      ctx.quadraticCurveTo(432, 88, 432, 92);
      ctx.lineTo(8 + r, 92);
      ctx.quadraticCurveTo(8, 92, 8, 88 - r);
      ctx.lineTo(8, 8 + r);
      ctx.quadraticCurveTo(8, 8, 8 + r, 8);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = colorHex;
      ctx.beginPath();
      ctx.arc(42, 48, 12, 0, Math.PI * 2);
      ctx.fill();

      ctx.font = "bold 30px -apple-system, BlinkMacSystemFont, sans-serif";
      ctx.fillStyle = "#ffffff";
      ctx.textAlign = "left";
      ctx.textBaseline = "middle";
      ctx.fillText(displayText, 70, 49);

      const texture = new THREE.CanvasTexture(canvas);
      texture.minFilter = THREE.LinearFilter;
      const spriteMat = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
      const sprite = new THREE.Sprite(spriteMat);
      sprite.scale.set(9.0, 2.1, 1);
      return sprite;
    }

    const container = document.getElementById("webgl-container");
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);
    scene.fog = new THREE.FogExp2(0x000000, 0.0075);

    const camera = new THREE.PerspectiveCamera(38, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(55, 42, 70);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    container.appendChild(renderer.domElement);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.maxDistance = 200;
    controls.minDistance = 15;

    scene.add(new THREE.AmbientLight(0xffffff, 0.9));
    const dirLight = new THREE.DirectionalLight(0xffffff, 0.5);
    dirLight.position.set(30, 60, 30);
    scene.add(dirLight);

    function createDarkMapTexture() {
      const canvas = document.createElement("canvas");
      canvas.width = 2048;
      canvas.height = 2048;
      const ctx = canvas.getContext("2d");

      ctx.fillStyle = "#101016";
      ctx.fillRect(0, 0, 2048, 2048);

      ctx.strokeStyle = "#1d1d28";
      ctx.lineWidth = 1.5;
      for (let i = 80; i < 2048; i += 120) {
        ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 2048); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(2048, i); ctx.stroke();
      }

      Object.keys(CITIES).forEach(cityName => {
        const c = CITIES[cityName];
        const px = 1024 + c.x * 22;
        const py = 1024 + c.z * 22;

        ctx.beginPath();
        ctx.arc(px, py, 4.0, 0, Math.PI * 2);
        ctx.fillStyle = "#e64539";
        ctx.fill();

        ctx.font = "bold 21px sans-serif";
        ctx.fillStyle = "#ffffff";
        ctx.textAlign = "left";
        ctx.fillText(cityName, px + 10, py + 7);
      });

      return new THREE.CanvasTexture(canvas);
    }

    const mapGeo = new THREE.PlaneGeometry(100, 100);
    const mapMat = new THREE.MeshBasicMaterial({ map: createDarkMapTexture(), side: THREE.DoubleSide });
    const mapMesh = new THREE.Mesh(mapGeo, mapMat);
    mapMesh.rotation.x = -Math.PI / 2;
    mapMesh.position.y = BASE_Y;
    scene.add(mapMesh);

    Object.keys(CITIES).forEach(cityName => {
      const pos = CITIES[cityName];
      
      const lineGeo = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(pos.x, BASE_Y, pos.z),
        new THREE.Vector3(pos.x, -BASE_Y, pos.z)
      ]);
      const lineMat = new THREE.LineDashedMaterial({ color: 0x333344, dashSize: 1.2, gapSize: 2.0 });
      const cityLine = new THREE.Line(lineGeo, lineMat);
      cityLine.computeLineDistances();
      scene.add(cityLine);
    });

    const ringRadius = 40;
    const ringYears = [1895, 1911, 1938, 1945, 1949, 1950, 1963, 1973, 1974, 1995, 2005, 2012, 2015, 2026];
    ringYears.forEach(yr => {
      const y = yearToY(yr);
      const ringGeo = new THREE.BufferGeometry();
      const pts = [];
      for (let a = 0; a <= Math.PI * 2 + 0.1; a += 0.15) {
        pts.push(new THREE.Vector3(Math.cos(a) * ringRadius, y, Math.sin(a) * ringRadius));
      }
      ringGeo.setFromPoints(pts);
      const ringMat = new THREE.LineBasicMaterial({ color: 0x222230, transparent: true, opacity: 0.6 });
      scene.add(new THREE.Line(ringGeo, ringMat));
    });

    const dynamicTrailLines = {};
    Object.keys(TRAJECTORIES).forEach(key => {
      const trailGeo = new THREE.BufferGeometry();
      const trailMat = new THREE.LineBasicMaterial({
        vertexColors: true,
        linewidth: 2.8,
        transparent: true,
        opacity: 0.95
      });
      const trailLine = new THREE.Line(trailGeo, trailMat);
      scene.add(trailLine);
      dynamicTrailLines[key] = trailLine;
    });

    const sliceGeo = new THREE.CylinderGeometry(ringRadius + 0.5, ringRadius + 0.5, 0.2, 48);
    const sliceMat = new THREE.MeshBasicMaterial({ color: 0xe64539, transparent: true, opacity: 0.08, side: THREE.DoubleSide });
    const sliceMesh = new THREE.Mesh(sliceGeo, sliceMat);
    scene.add(sliceMesh);

    const particleSpheres = {};
    const nameSprites = {};
    const leaderLines = {};
    const groundShadowRings = {};
    const verticalDropLines = {};

    Object.keys(TRAJECTORIES).forEach(key => {
      const item = TRAJECTORIES[key];

      const sphGeo = new THREE.SphereGeometry(0.38, 16, 16);
      const sphMat = new THREE.MeshBasicMaterial({ color: item.colorThree });
      const sph = new THREE.Mesh(sphGeo, sphMat);
      scene.add(sph);
      particleSpheres[key] = sph;

      const sprite = createNameSprite(item.name + " · 启动", item.colorHex);
      scene.add(sprite);
      nameSprites[key] = sprite;

      const leaderGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
      const leaderMat = new THREE.LineBasicMaterial({ color: item.colorThree, transparent: true, opacity: 0.7 });
      const leaderLine = new THREE.Line(leaderGeo, leaderMat);
      scene.add(leaderLine);
      leaderLines[key] = leaderLine;

      const ringGeo = new THREE.RingGeometry(0.05, 0.15, 16);
      const ringMat = new THREE.MeshBasicMaterial({ color: item.colorThree, side: THREE.DoubleSide, transparent: true, opacity: 0.85 });
      const shadowRing = new THREE.Mesh(ringGeo, ringMat);
      shadowRing.rotation.x = -Math.PI / 2;
      shadowRing.position.y = BASE_Y + 0.05;
      scene.add(shadowRing);
      groundShadowRings[key] = shadowRing;

      const dropLineGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, BASE_Y, 0), new THREE.Vector3(0, 0, 0)]);
      const dropLineMat = new THREE.LineBasicMaterial({ color: item.colorThree, transparent: true, opacity: 0.35 });
      const dropLine = new THREE.Line(dropLineGeo, dropLineMat);
      scene.add(dropLine);
      verticalDropLines[key] = dropLine;
    });

    const DEFAULT_PINS = [{ id: "p1", city: "基隆", year: 1949, author: "老兵后代", msg: "在此扎根，岁月回响。" }];
    let userPinsList = JSON.parse(localStorage.getItem('rye_spacetime_pushpins_v26')) || DEFAULT_PINS;
    const pinObjectsGroup = new THREE.Group();
    scene.add(pinObjectsGroup);

    let isAdminMode = false;
    function toggleAdminMode() {
      isAdminMode = !isAdminMode;
      const btn = document.getElementById("admin-toggle-btn");
      btn.innerText = isAdminMode ? "退出管理" : "开启管理";
      btn.classList.toggle("active", isAdminMode);
      renderAllPushPins();
    }

    function createPushPinMesh(pinData) {
      const group = new THREE.Group();
      const cityPos = CITIES[pinData.city] || { x: 0, z: 0 };
      const y = yearToY(pinData.year);
      const pinLocalGroup = new THREE.Group();

      const pinMat = new THREE.MeshStandardMaterial({
        color: 0xd4a373,
        emissive: 0x5a3d1e,
        emissiveIntensity: 0.4,
        roughness: 0.3
      });

      const capGeo = new THREE.CylinderGeometry(0.26, 0.26, 0.09, 16);
      const capMesh = new THREE.Mesh(capGeo, pinMat);
      capMesh.position.set(0, 0.28, 0);
      pinLocalGroup.add(capMesh);

      const needleGeo = new THREE.ConeGeometry(0.035, 0.3, 8);
      const needleMat = new THREE.MeshBasicMaterial({ color: 0xcccccc });
      const needleMesh = new THREE.Mesh(needleGeo, needleMat);
      needleMesh.rotation.x = Math.PI;
      needleMesh.position.set(0, -0.12, 0);
      pinLocalGroup.add(needleMesh);

      pinLocalGroup.position.set(cityPos.x, y, cityPos.z);
      pinLocalGroup.userData = pinData;
      capMesh.userData = pinData;

      group.add(pinLocalGroup);
      return group;
    }

    function renderAllPushPins() {
      while(pinObjectsGroup.children.length > 0) {
        pinObjectsGroup.remove(pinObjectsGroup.children[0]);
      }
      userPinsList.forEach(pin => {
        pinObjectsGroup.add(createPushPinMesh(pin));
      });

      const container = document.getElementById("pin-items-container");
      document.getElementById("pin-count").innerText = userPinsList.length;
      container.innerHTML = "";

      userPinsList.slice().reverse().forEach(pin => {
        const itemDiv = document.createElement("div");
        itemDiv.className = "pin-item" + (isAdminMode ? " admin-mode" : "");
        itemDiv.onclick = (e) => {
          if (!e.target.classList.contains('btn-delete-pin')) focusOnPushPin(pin);
        };
        itemDiv.innerHTML = `
          <button class="btn-delete-pin" onclick="deletePin('${pin.id}')">删</button>
          <div class="pin-item-head"><span>📍 ${pin.city} · ${pin.year}年</span><span style="color:#a4a096;font-size:9.5px;">${pin.author}</span></div>
          <div class="pin-item-body">${pin.msg}</div>
        `;
        container.appendChild(itemDiv);
      });
    }

    function deletePin(id) {
      userPinsList = userPinsList.filter(p => p.id !== id);
      localStorage.setItem('rye_spacetime_pushpins_v26', JSON.stringify(userPinsList));
      renderAllPushPins();
      pinTooltip.style.display = "none";
    }

    function focusOnPushPin(pin) {
      updateSpacetime(parseFloat(pin.year));
      const c = CITIES[pin.city] || { x: 0, z: 0 };
      controls.target.set(c.x, yearToY(pin.year), c.z);
    }

    function submitPushPin() {
      const city = document.getElementById("user-city").value;
      const year = parseFloat(document.getElementById("user-year").value);
      const author = document.getElementById("user-author").value.trim() || "时空访客";
      const msg = document.getElementById("user-msg").value.trim();

      if (!msg) { alert("请写下一句留言。"); return; }
      if (year > 2026 || year < 1895) { alert("年份须在 1895 至 2026 之间。"); return; }

      userPinsList.push({ id: "pin_" + Date.now(), city, year, author, msg });
      localStorage.setItem('rye_spacetime_pushpins_v26', JSON.stringify(userPinsList));
      document.getElementById("user-msg").value = "";
      renderAllPushPins();
    }

    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    const pinTooltip = document.getElementById("pin-tooltip-card");

    window.addEventListener("pointerdown", (event) => {
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(pinObjectsGroup.children, true);

      if (intersects.length > 0) {
        let hit = null;
        intersects.forEach(i => {
          let curr = i.object;
          while(curr) {
            if (curr.userData && curr.userData.city) { hit = curr.userData; break; }
            curr = curr.parent;
          }
        });
        if (hit) {
          pinTooltip.style.display = "block";
          pinTooltip.style.left = Math.min(window.innerWidth - 270, event.clientX + 14) + "px";
          pinTooltip.style.top = Math.max(20, event.clientY - 30) + "px";
          pinTooltip.innerHTML = `
            <div style="font-weight:750;color:var(--gold);margin-bottom:3px;display:flex;justify-content:space-between;"><span>📌 读者时空留名</span><span style="font-size:10px;">${hit.year}年</span></div>
            <div><strong>地点：</strong>${hit.city}</div>
            <div><strong>留名人：</strong>${hit.author}</div>
            <div style="margin:4px 0;padding:4px 0;border-top:1px dashed #333;color:#f0f0f0;">“${hit.msg}”</div>
          `;
          focusOnPushPin(hit);
          setTimeout(() => { pinTooltip.style.display = "none"; }, 6000);
        }
      } else {
        pinTooltip.style.display = "none";
      }
    });

    const slider = document.getElementById("year-slider");
    const yearDisplay = document.getElementById("year-val");
    let isPlaying = true;
    let playInterval = null;

    const lastRenderedText = {};

    function updateSpacetime(year) {
      yearDisplay.innerText = Math.round(year);
      slider.value = year;
      sliceMesh.position.y = yearToY(year);

      Object.keys(TRAJECTORIES).forEach(key => {
        const item = TRAJECTORIES[key];
        const pos = getEntityPosAtYear(key, year);
        const sph = particleSpheres[key];
        let sprite = nameSprites[key];
        const leader = leaderLines[key];
        const shadow = groundShadowRings[key];
        const dropLine = verticalDropLines[key];
        const trailLine = dynamicTrailLines[key];

        const historyPoints = [];
        const historyColors = [];
        const startYear = item.keyframes[0].year;
        const endYear = Math.min(year, item.disappearYear || 2026);

        if (year >= startYear) {
          const baseColor = new THREE.Color(item.colorHex);
          const darkFadeColor = new THREE.Color("#101018");

          for (let y = startYear; y <= endYear; y += 0.12) {
            const p = getEntityPosAtYear(key, y);
            if (p) {
              historyPoints.push(new THREE.Vector3(p.x, p.y, p.z));
              const age = Math.max(0, year - y);
              const tFade = Math.min(1.0, age / 35.0);
              const c = baseColor.clone().lerp(darkFadeColor, tFade * 0.85);
              historyColors.push(c.r, c.g, c.b);
            }
          }
        }

        if (historyPoints.length >= 2) {
          trailLine.visible = true;
          trailLine.geometry.setFromPoints(historyPoints);
          trailLine.geometry.setAttribute('color', new THREE.Float32BufferAttribute(historyColors, 3));
        } else {
          trailLine.visible = false;
        }

        let isVisible = false;
        let pulseFactor = 1.0;
        let isFlashing = false;

        if (year >= startYear) {
          if (!item.disappearYear || year < item.disappearYear) {
            isVisible = true;
            isFlashing = false;
            pulseFactor = 1.0;
          } else if (item.disappearYear) {
            const delta = year - item.disappearYear;
            const flashDuration = 2.5;
            if (delta <= flashDuration) {
              isVisible = true;
              isFlashing = true;
              const wave = Math.abs(Math.sin(delta * 10.0));
              const fade = 1.0 - (delta / flashDuration);
              pulseFactor = 0.2 + wave * 0.8 * fade;
            } else {
              isVisible = false;
            }
          }
        }

        if (isVisible && pos) {
          sph.visible = true;
          sprite.visible = true;
          leader.visible = true;
          shadow.visible = true;
          dropLine.visible = true;

          // 核心更新：动态拼接“姓名 · 当前城市”
          const cityName = pos.currentCity || "途中";
          const currentText = `${item.name} · ${cityName}`;
          if (lastRenderedText[key] !== currentText) {
            lastRenderedText[key] = currentText;
            scene.remove(sprite);
            sprite.material.map.dispose();
            sprite.material.dispose();
            const newSprite = createNameSprite(currentText, item.colorHex);
            scene.add(newSprite);
            nameSprites[key] = newSprite;
            sprite = newSprite;
          }

          if (isFlashing) {
            sph.scale.setScalar(1.0 + pulseFactor * 2.8);
            sph.material.opacity = pulseFactor;
            sprite.scale.set(8.5 * (1.0 + pulseFactor * 0.4), 2.1 * (1.0 + pulseFactor * 0.4), 1);
            sprite.material.opacity = pulseFactor;
            leader.material.opacity = pulseFactor * 0.8;
            shadow.material.opacity = pulseFactor * 0.9;
          } else {
            sph.scale.setScalar(1.0);
            sph.material.opacity = 1.0;
            sprite.scale.set(8.5, 2.1, 1);
            sprite.material.opacity = 1.0;
            leader.material.opacity = 0.7;
            shadow.material.opacity = 0.85;
          }

          sph.position.set(pos.x, pos.y, pos.z);

          const targetSpritePos = new THREE.Vector3(
            pos.x + item.labelOffset.x,
            pos.y + item.labelOffset.y,
            pos.z + item.labelOffset.z
          );
          sprite.position.copy(targetSpritePos);

          leader.geometry.setFromPoints([
            new THREE.Vector3(pos.x, pos.y, pos.z),
            targetSpritePos
          ]);

          shadow.position.set(pos.baseX, BASE_Y + 0.05, pos.baseZ);
          dropLine.geometry.setFromPoints([
            new THREE.Vector3(pos.x, BASE_Y, pos.z),
            new THREE.Vector3(pos.x, pos.y, pos.z)
          ]);
        } else {
          sph.visible = false;
          sprite.visible = false;
          leader.visible = false;
          shadow.visible = false;
          dropLine.visible = false;
        }
      });
    }

    slider.addEventListener("input", (e) => {
      updateSpacetime(parseFloat(e.target.value));
    });

    function startLoopPlay() {
      if (playInterval) clearInterval(playInterval);
      playInterval = setInterval(() => {
        let y = parseFloat(slider.value) + 0.09;
        if (y > MAX_YEAR) y = MIN_YEAR;
        updateSpacetime(y);
      }, 45);
    }

    function togglePlay() {
      const btn = document.getElementById("btn-play");
      if (isPlaying) {
        clearInterval(playInterval);
        isPlaying = false;
        btn.innerText = "继续播放 ▶";
      } else {
        isPlaying = true;
        btn.innerText = "暂停播放 ❚❚";
        startLoopPlay();
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }

    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    updateSpacetime(1895);
    renderAllPushPins();
    startLoopPlay();
    animate();
  </script>
</body>
</html>

